{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FretLab",
  "version": "1.3.0",
  "identifier": "br.fretlab.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Teoria musical no braço da guitarra e do baixo",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0MTU4OTVFRDRBRTI4MEIKUldRTEtLN1VYb2tWQlBWekJidHdzTWFVb2cwMGNnZkdnVHRETXJxTEtLMHY3NVBEWWIxZ2l1eTkK",
      "endpoints": [
        "https://github.com/CalegarisFotoeFilme/Fretlab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
