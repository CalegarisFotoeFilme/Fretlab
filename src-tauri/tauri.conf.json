{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FretLab",
  "version": "0.1.0",
  "identifier": "br.fretlab.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Teoria musical no braço da guitarra e do baixo",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
