{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "App servido em http://localhost: eventos, comandos e HTTP só para a API do Songsterr",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://www.songsterr.com/api/*"
        }
      ]
    },
    "allow-open-songsterr",
    "allow-read-download",
    "log:default"
  ],
  "remote": {
    "urls": [
      "http://localhost:*"
    ]
  }
}
