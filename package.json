    "@tonejs/midi": "^2.0.28",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "pitchy": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
